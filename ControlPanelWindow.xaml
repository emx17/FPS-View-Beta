<Window x:Class="FPSOverlay.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="emx17 FPS Viewer Beta" Height="560" Width="850"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#1A1A1A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ContentSite"
                                        Content="{TemplateBinding SelectionBoxItem}"
                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                        Margin="8,4,0,4"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False"
                                        TextBlock.Foreground="#FFFFFF"
                                        TextBlock.FontSize="12"/>
                                    <ToggleButton Grid.Column="0" Grid.ColumnSpan="2"
                                        Focusable="False"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#888888" StrokeThickness="1.5"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border Background="#1C1C1C" BorderBrush="#E31E24" BorderThickness="1" CornerRadius="0,0,2,2">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#E31E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1C1C1C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextBlock.Foreground="#FFFFFF"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1A1A1A"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#E31E24"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="2,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="36" Height="18" Margin="0,0,10,0">
                                <Border x:Name="Track" CornerRadius="9" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="1"/>
                                <Border x:Name="Glow" CornerRadius="9" Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF0033" Offset="0"/>
                                            <GradientStop Color="#CC0029" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,21,0" Fill="#555555"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#FF0033"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="21,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#222222"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1A1A1A"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF0033"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PosBtn" TargetType="RadioButton">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BtnBorder" Background="#1A1A1A" CornerRadius="2" BorderBrush="#2A2A2A" BorderThickness="1">
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E31E24"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF0033"/>
                                <Setter TargetName="BtnBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E31E24" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="0" BorderThickness="1" BorderBrush="#1A1A1A" ClipToBounds="True" Background="#0C0C0C">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.9"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Border Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="emx17 FPS Viewer Beta" Foreground="#888888" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="—" Style="{StaticResource TitleBarBtn}" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Style="{StaticResource CloseBtn}" Click="BtnClose_Click" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Height="2" Background="#FF0033"/>

            <!-- MAIN CONTENT - 2 COLUMNS -->
            <Grid Grid.Row="2" Margin="16,14,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <StackPanel Grid.Column="0">
                    <!-- LANGUAGE -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblLanguage" Text="DİL / LANGUAGE" Style="{StaticResource SectionHeader}"/>
                            <ComboBox x:Name="CmbLanguage" Height="26" FontSize="12" SelectionChanged="InteractiveElement_Changed">
                                <ComboBoxItem Content="Türkçe (TR)" Tag="TR"/>
                                <ComboBoxItem Content="English (EN)" Tag="EN"/>
                                <ComboBoxItem Content="Deutsch (DE)" Tag="DE"/>
                                <ComboBoxItem Content="Español (ES)" Tag="ES"/>
                                <ComboBoxItem Content="Français (FR)" Tag="FR"/>
                                <ComboBoxItem Content="Português (PT)" Tag="PT"/>
                                <ComboBoxItem Content="Português Brasil (BR)" Tag="BR"/>
                                <ComboBoxItem Content="Русский (RU)" Tag="RU"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- PROFILE -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblProfile" Text="OVERLAY PROFİLİ / THEME" Style="{StaticResource SectionHeader}"/>
                            <ComboBox x:Name="CmbProfile" Height="26" FontSize="12" SelectionChanged="InteractiveElement_Changed">
                                <ComboBoxItem Content="Classic Minimalist" Tag="0"/>
                                <ComboBoxItem Content="Gamer Panel" Tag="1"/>
                                <ComboBoxItem Content="Steam Deck Style" Tag="2"/>
                                <ComboBoxItem Content="Advanced Performance HUD" Tag="3"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- APPEARANCE -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblAppearance" Text="GÖRÜNÜM" Style="{StaticResource SectionHeader}"/>
                            
                            <TextBlock x:Name="LblOverlayColor" Text="Overlay Rengi" Foreground="#777" FontSize="11" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                    <Button x:Name="BtnCustomColor" Content="Özel Renk Seç / Custom Color" Background="#151515" Foreground="#CCC" BorderBrush="#333" BorderThickness="1" Height="30" Padding="15,0" Cursor="Hand" Click="BtnCustomColor_Click"/>
                                </StackPanel>
                                <Border x:Name="ColorPreview" Grid.Column="1" Width="32" Height="32" CornerRadius="2" Background="#00E68A" BorderBrush="#333333" BorderThickness="1" Margin="10,0,0,0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblFontSize" Text="Yazı Boyutu" Foreground="#777" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="SliderFontSize" Grid.Column="1" Minimum="10" Maximum="48" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderFontSize_ValueChanged" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtFontSizeVal" Grid.Column="2" Text="20 px" Foreground="#E31E24" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- POSITION -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblPosition" Text="POZİSYON &amp; HİZALAMA" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="ChkPositionUnlock" Style="{StaticResource ToggleSwitch}" Content="ğŸ”“ Pozisyon Kilidini Aç (Sürükle)" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                                      
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <UniformGrid Grid.Column="0" Rows="3" Columns="3" Width="64" Height="64" Margin="0,0,16,0">
                                    <RadioButton x:Name="PosTL" Style="{StaticResource PosBtn}" Tag="TopLeft" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosTC" Style="{StaticResource PosBtn}" Tag="TopCenter" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosTR" Style="{StaticResource PosBtn}" Tag="TopRight" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosML" Style="{StaticResource PosBtn}" Tag="MiddleLeft" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosMC" Style="{StaticResource PosBtn}" Tag="Center" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosMR" Style="{StaticResource PosBtn}" Tag="MiddleRight" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosBL" Style="{StaticResource PosBtn}" Tag="BottomLeft" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosBC" Style="{StaticResource PosBtn}" Tag="BottomCenter" Checked="InteractiveElement_Changed"/>
                                    <RadioButton x:Name="PosBR" Style="{StaticResource PosBtn}" Tag="BottomRight" Checked="InteractiveElement_Changed"/>
                                </UniformGrid>
                                
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="LblPadding" Text="Kenar Boşluğu" Foreground="#777" FontSize="11" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="TxtPaddingVal" Text="25 px" Foreground="#E31E24" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="SliderPadding" Minimum="0" Maximum="100" Value="25" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SliderPadding_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Grid.Column="2">
                    <!-- SENSORS -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblSensors" Text="SENSÖRLER" Style="{StaticResource SectionHeader}"/>
                            <CheckBox x:Name="ChkShowGpuName" Style="{StaticResource ToggleSwitch}" Content="GPU Adını Göster" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                            <CheckBox x:Name="ChkShowCpu" Style="{StaticResource ToggleSwitch}" Content="CPU Sıcaklığı" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                            <CheckBox x:Name="ChkShowGpu" Style="{StaticResource ToggleSwitch}" Content="GPU Sıcaklığı" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                            <CheckBox x:Name="ChkShowRam" Style="{StaticResource ToggleSwitch}" Content="RAM Kullanımı" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                            <CheckBox x:Name="ChkShowVram" Style="{StaticResource ToggleSwitch}" Content="VRAM Kullanımı" Margin="0" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed"/>
                        </StackPanel>
                    </Border>

                    <!-- GPU SELECTION -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel>
                            <TextBlock x:Name="LblGpuSelect" Text="AKTİF GPU SEÇİMİ" Style="{StaticResource SectionHeader}"/>
                            <ComboBox x:Name="CmbGpuSelector" Height="26" FontSize="12" SelectionChanged="InteractiveElement_Changed">
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- OVERLAY TOGGLE -->
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LblOverlayCtrl" Text="OVERLAY KONTROL" Foreground="#666666" FontSize="10" FontWeight="Bold"/>
                                <TextBlock x:Name="LblOverlayToggle" Text="Ekranda göster / gizle" Foreground="#444444" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkOverlayActive" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Margin="0" IsChecked="True" Checked="InteractiveElement_Changed" Unchecked="InteractiveElement_Changed" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- GITHUB FOOTER -->
                    <Border Margin="0,20,0,0" Cursor="Hand" MouseLeftButtonDown="GitHub_Click" Background="Transparent" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Path Data="M12,0.297C5.37,0.297,0,5.67,0,12.297c0,5.303,3.438,9.8,8.205,11.387c0.6,0.113,0.82-0.26,0.82-0.577 c0-0.285-0.01-1.04-0.015-2.04c-3.338,0.725-4.042-1.61-4.042-1.61C4.422,18.07,3.633,17.7,3.633,17.7 c-1.087-0.743,0.082-0.729,0.082-0.729c1.205,0.084,1.839,1.237,1.839,1.237c1.07,1.834,2.807,1.304,3.492,0.997 c0.107-0.775,0.418-1.305,0.762-1.604c-2.665-0.305-5.467-1.334-5.467-5.931c0-1.311,0.469-2.381,1.236-3.221 c-0.124-0.303-0.535-1.524,0.117-3.176c0,0,1.008-0.322,3.301,1.23c0.957-0.266,1.983-0.399,3.003-0.404 c1.02,0.005,2.047,0.138,3.006,0.404c2.291-1.552,3.297-1.23,3.297-1.23c0.653,1.653,0.242,2.874,0.118,3.176 c0.77,0.84,1.235,1.911,1.235,3.221c0,4.609-2.807,5.624-5.479,5.921c0.43,0.372,0.814,1.102,0.814,2.222 c0,1.606-0.014,2.898-0.014,3.293c0,0.319,0.216,0.694,0.824,0.576C20.565,22.092,24,17.592,24,12.297 C24,5.67,18.627,0.297,12,0.297" Fill="#555555" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock Text="github.com/emx17" Foreground="#555555" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="Version Beta v3.0" Foreground="#444444" FontSize="10" 
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"/>
            </Grid>
        </Grid>
    </Border>
</Window>

